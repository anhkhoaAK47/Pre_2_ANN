# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
PORT=8004  # Port for ANN version (main_ann.py)
# PORT=8003  # Port for PhoBERT version (main.py)

# ========================================
# GEMINI API (REQUIRED)
# ========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Alternative models: gemini-1.5-flash, gemini-1.5-pro

# ========================================
# DATABASE (REQUIRED)
# ========================================
# MySQL/MariaDB (Production) - ANN version database
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/medical_chatbot_ann

# Old PhoBERT database (for reference)
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/triage_db

# SQLite (Development - uncomment to use)
# DATABASE_URL=sqlite:///./medical_chatbot_ann.db

# ========================================
# ANN MODEL CONFIGURATION (for main_ann.py)
# ========================================
# These paths are auto-configured in main_ann.py
# Uncomment only if you need to override defaults
# MODEL_PATH=building_ANN/models/pytorch/best_model.pth
# LABEL_ENCODER_PATH=building_ANN/models/pytorch/label_encoder.pkl
# TRAIN_DATA_PATH=building_ANN/data/processed/common/train.csv
# CONFUSION_MATRIX_PATH=building_ANN/data/evaluation/most_confused_pairs.csv
# DEPARTMENT_MAP_PATH=building_ANN/utils/department_map_577.json

# ========================================
# PHOBERT MODEL CONFIGURATION (for main.py - legacy)
# ========================================
# Only needed if running the old PhoBERT version
# MODEL_PATH=app_v2/models/ml/phobert_medchat_model.pt
# ID2LABEL_PATH=app_v2/utils/mappings/id2label.json
# TOP_K=3
# THRESHOLD=0.5

# ========================================
# DEPARTMENT MAPPING
# ========================================
DEPARTMENT_DEFAULT=Khám tổng quát
# ANN version uses department_map_577.json by default
# PhoBERT version uses department_map.json by default
